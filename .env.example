# Copie este arquivo para .env e ajuste os valores para sua maquina.
# O arquivo .env real nao deve ser enviado para o Git.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestaoacoesdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

BRASIL_API_BASE_URL=https://brasilapi.com.br
BRASIL_API_CONNECT_TIMEOUT=2s
BRASIL_API_READ_TIMEOUT=5s
VIA_CEP_BASE_URL=https://viacep.com.br
VIA_CEP_CONNECT_TIMEOUT=2s
VIA_CEP_READ_TIMEOUT=5s

BRAPI_API_KEY=substitua-pela-sua-chave
BRAPI_BASE_URL=https://brapi.dev
BRAPI_CONNECT_TIMEOUT=2s
BRAPI_READ_TIMEOUT=5s

ALPHA_VANTAGE_API_KEY=substitua-pela-sua-chave
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_CONNECT_TIMEOUT=2s
ALPHA_VANTAGE_READ_TIMEOUT=5s

# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=gestaoacoesdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
APP_PORT=8080
