POSTGRES_DB=gestaoacoesdb
POSTGRES_USER=gestaoacoes
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200
SPRING_PROFILES_ACTIVE=dev
BRAPI_API_KEY=
ALPHA_VANTAGE_API_KEY=
BRASIL_API_BASE_URL=https://brasilapi.com.br
VIA_CEP_BASE_URL=https://viacep.com.br
BRAPI_BASE_URL=https://brapi.dev
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co
ALPHA_VANTAGE_QUOTE_REUSE_INTERVAL=15m
ALPHA_VANTAGE_REFRESH_COOLDOWN=15m
BRASIL_API_CONNECT_TIMEOUT=2s
BRASIL_API_READ_TIMEOUT=5s
VIA_CEP_CONNECT_TIMEOUT=2s
VIA_CEP_READ_TIMEOUT=5s
BRAPI_CONNECT_TIMEOUT=2s
BRAPI_READ_TIMEOUT=5s
ALPHA_VANTAGE_CONNECT_TIMEOUT=2s
ALPHA_VANTAGE_READ_TIMEOUT=5s

# As linhas anteriores são exclusivamente do Compose de desenvolvimento.
# Operacional: usar arquivo externo explícito --env-file; NÃO combinar os Composes.
# O executor ops/homologacao.cjs gera estes valores exclusivos e verifica propriedade.
OP_PROJECT=
OP_RUN_ID=
OP_PRIVATE_DIR=
OP_DB_NAME=
OP_DB_APP_USER=
OP_BOOTSTRAP_USER=
OP_POSTGRES_IMAGE=
OP_BACKEND_IMAGE=
OP_FRONTEND_IMAGE=
OP_INGRESS_NETWORK=
OP_API_NETWORK=
OP_DATABASE_NETWORK=
OP_DATA_VOLUME=
APP_TRUSTED_PROXY_IP=
# Sem AUTH_JWT_SECRET/AUTH_RESET_SECRET em .env: arquivos externos configtree,
# auth.jwt.secret e auth.reset.secret, cada um Base64 de >=32 bytes aleatórios.
# Senhas de provisionamento/app/bootstrap e server.key também somente em arquivos externos.
