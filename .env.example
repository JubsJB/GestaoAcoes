# Copie este arquivo para .env e ajuste os valores para sua maquina.
# O arquivo .env real nao deve ser enviado para o Git.

SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestaoacoesdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Variaveis utilizadas pelo Docker Compose
POSTGRES_DB=gestaoacoesdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
APP_PORT=8080
