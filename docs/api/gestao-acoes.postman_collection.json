                "exec": [
                  "pm.test(\"Status esperado: 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Resposta JSON\", function () { pm.response.json(); });",
                  "if (pm.response.code === 201) { const body = pm.response.json(); if (body.id != null) pm.collectionVariables.set(\"operacaoId\", String(body.id)); }"
